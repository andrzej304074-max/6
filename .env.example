# Skopiuj ten plik jako .env i uzupełnij wartości.

# Twój adres Gmail, z którego będą wysyłane maile
GMAIL_USER=twoj.adres@gmail.com

# Hasło aplikacji Google (NIE zwykłe hasło do konta!)
# Jak je wygenerować: https://myaccount.google.com/apppasswords
# (wymaga włączonej weryfikacji dwuetapowej na koncie Google)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Stały adresat — na ten adres pójdzie każdy mail
RECIPIENT_EMAIL=adresat@example.com

# Port serwera (opcjonalnie, domyślnie 3000)
# PORT=3000
